# Copy to `.env` and fill in. Nothing here is secret in development.

# ── Database ────────────────────────────────────────────────────────────────
# Local Postgres:
#   DATABASE_URL="postgresql://postgres@localhost:5432/flatirons?schema=public"
#
# Supabase: Project settings → Database → Connection string. Two URLs matter —
# use the pooled one (pgbouncer, port 6543) for the app, and the direct one
# (port 5432) for `db:migrate` and `db:deploy`, because migrations need a
# session-mode connection that a pooler will not give them.
DATABASE_URL="postgresql://postgres@localhost:5432/flatirons?schema=public"

# ── Site ────────────────────────────────────────────────────────────────────
# Read by src/app/sitemap.ts. Falls back to the production hostname.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
